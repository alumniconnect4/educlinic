# Database Settings
POSTGRES_DB=educlinic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Settings
PORT=5000
NODE_ENV=DEVELOPMENT
JWT_ACCESS_SECRET=supersecretjwtkey12345
JWT_TOKEN_EXPIRY=86400
DATABASE_URL=postgresql://postgres:postgres@db:5432/educlinic?schema=public

# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret